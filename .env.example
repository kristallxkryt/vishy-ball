# Comma-separated browser origins allowed to call the FastAPI backend.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public URL of the backend, used by the Next.js browser client.
# Set this in frontend/.env.local.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# SMTP settings for registration verification and account security emails.
# Keep real credentials in your local .env or hosting environment, never in Git.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-mailbox@example.com
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM=your-mailbox@example.com
SMTP_USE_TLS=true
